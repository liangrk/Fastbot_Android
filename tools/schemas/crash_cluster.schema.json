{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "crash_cluster",
  "description": "Fastbot 崩溃聚类行（clusters.jsonl 单行对象）",
  "type": "object",
  "properties": {
    "signature": { "type": "string", "minLength": 1, "description": "sha1(异常类型+归一化帧)[:16]" },
    "kind": { "enum": ["crash", "anr"] },
    "count": { "type": "integer", "minimum": 1 },
    "first_seen": { "type": "string", "description": "yyyyMMddHHmmss（空串=来源无时间戳）" },
    "last_seen": { "type": "string", "description": "yyyyMMddHHmmss（空串=来源无时间戳）" },
    "exception_line": { "type": "string" },
    "top_frames": { "type": "array", "items": { "type": "string" } },
    "processes": { "type": "array", "items": { "type": "string" } },
    "version_codes": { "type": "array", "items": { "type": "integer" } },
    "activities": { "type": "array", "items": { "type": "string" } },
    "representative_stack": { "type": "string" }
  },
  "required": ["signature", "kind", "count", "first_seen", "last_seen",
               "exception_line", "top_frames", "representative_stack"],
  "additionalProperties": false
}
